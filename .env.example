# =============================================================================
# PREMIERS AI — Environment Configuration Template
# All secret values below are placeholders. DO NOT commit actual secrets.
# =============================================================================

# Server Runtime Configuration
PORT=3000
NODE_ENV=production
APP_URL="http://localhost:3000"

# AI Provider Configuration (Google Gemini API)
# Required for Gemini 3.8 Flash & Multilingual reasoning.
# Managed via AI Studio Secrets in hosted mode.
GEMINI_API_KEY="your_gemini_api_key_here"

# Authentication & Session Security
# 32+ character high-entropy secret used for HMAC-SHA256 tokens and session signing
JWT_SECRET="premiers_ai_secure_production_secret_key_change_in_prod_2026"
JWT_EXPIRES_IN="7d"

# Database Configuration
# Embedded SQLite relational database engine with WAL journal mode
DATABASE_PATH="./data/premiers.db"

# Payment Providers Configuration
# Stripe Checkout & Subscription Webhooks
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_PUBLISHABLE_KEY="pk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"

# Local / Regional Payment Gateways (Pakistan / South Asia)
EASYPAISA_STORE_ID="easypaisa_store_placeholder"
EASYPAISA_HASH_KEY="easypaisa_hash_key_placeholder"
JAZZCASH_MERCHANT_ID="jazzcash_merchant_placeholder"
JAZZCASH_PASSWORD="jazzcash_password_placeholder"
JAZZCASH_INTEGERITY_SALT="jazzcash_salt_placeholder"

# Email & Notification Provider (SMTP)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER="smtp_user_placeholder"
SMTP_PASS="smtp_pass_placeholder"
EMAIL_FROM="notifications@premiers.ai"

# Initial Default Administrator Setup (Seeded automatically if empty)
ADMIN_NAME="Syed Muhammad Yasir Abbas Zaidi"
ADMIN_EMAIL="admin@premiers.ai"
ADMIN_INITIAL_PASSWORD="Admin@Premiers2026!"

# Storage & Upload Limits
MAX_UPLOAD_SIZE_MB=25
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/webp,image/svg+xml,application/pdf,text/plain"
